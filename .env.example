# Copia este archivo como .env.local y coloca tus credenciales reales de Supabase

# Credenciales de Supabase (usadas por src/lib/supabase.ts)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SECRET_KEY="tu-service-role-o-secret-key"
SUPABASE_PUBLISHABLE_KEY="tu-anon-o-publishable-key"

# Conexión directa opcional a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/love_heals_effect"

# Secreto para firmar las sesiones/cookies de Login
AUTH_SECRET="cambia-esta-clave-por-una-muy-larga-y-segura"

# Correo SMTP directo (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Love Heals Effect" <contacto@lovehealseffect.com>'

# Llave de Google AI Studio (Gemini API) para PONO IA interna
GEMINI_API_KEY=""
